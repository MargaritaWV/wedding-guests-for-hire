# Copy this file to .env.local only after creating the external services.
# Keep real values out of Git and out of browser-exposed NEXT_PUBLIC variables.

# Supabase server-side access
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key

# Telegram Bot API and webhook verification
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_value

# Google Sheets service-account access
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account-name@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_private_key\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=replace_with_spreadsheet_id

# Public deployment address, without a trailing slash
APP_BASE_URL=http://localhost:3000
